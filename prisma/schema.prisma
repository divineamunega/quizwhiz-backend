generator client {
  provider = "prisma-client-js"
}

// This schema defines the data model for a quiz application using Prisma.
// It includes models for User, Quiz, Question, Answer, and RefreshToken.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum QuizVisibility {
  PUBLIC
  PRIVATE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum VerificationType {
  EMAIL
  PASSWORD_RESET
}

model User {
  id           String         @id @default(uuid())
  name         String
  password     String?
  googleId     String?
  email        String         @unique
  emailVerified Boolean      @default(false) // Indicates if the email is verified
  googleVerified Boolean     @default(false) // Indicates if the Google account is verified
  verifyCode  String?      // Code for email verification
  createdAt    DateTime      @default(now())
  avatar       String?
  quizzes      Quiz[]         @relation("CreatedQuizzes")
  RefreshToken RefreshToken[]
  verificationCode VerificationCode[]
  quizParticipations QuizParticipant[]
}


model VerificationCode {
    id       String   @id @default(uuid())
    hashedCode String   @unique // Hashed verification code
    userId   String
    user    User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    expiresAt DateTime   // When the code expires
    type     VerificationType  // Type of verification (e.g., "email", "password_reset")
    isUsed   Boolean  @default(false) // Indicates if the code has been used

}

model RefreshToken {
  id        String   @id @default(uuid())
  value     String   @unique // Hashed refresh token string
  userId    String
  image     String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String? // For auditing/login location
  userAgent String? // For client identification (browser, device)
  revoked   Boolean  @default(false) // Marks if token is revoked
}

model Quiz {
  id                         String         @id @default(uuid())
  title                     String
  description       String
  creatorId           String
  image                 String?
  tags                    String[]
  visibility           QuizVisibility @default(PUBLIC) 
  creator              User           @relation(fields: [creatorId], references: [id], name: "CreatedQuizzes")
  questions         Question[] @relation("QuizQuestions")
  createdAt         DateTime       @default(now())
  quizSessions    QuizSession[]
}


enum QuizSessionType {
  LIVE
  SOLO
}

model QuizSession {
  id          String    @id @default(uuid())
  quizId      String
  isCompleted Boolean   @default(false) 
  hostId      String    // who started this session
  joinCode    String?   @unique  // only present for live sessions
  type        QuizSessionType @default(SOLO) // Type of session: LIVE or SOLO
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  participants QuizParticipant[]
}


model QuizParticipant {
  id          String    @id @default(uuid())
  quizSessionId String
  userId      String
  score       Int?       @default(0)
  quizSession QuizSession @relation(fields: [quizSessionId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([quizSessionId, userId]) 
}

model Question {
  id        String   @id @default(uuid())
  title     String
  image     String?
  createdAt DateTime @default(now())
  quizId    String
  quiz      Quiz     @relation(name: "QuizQuestions", fields: [quizId], references: [id])
  answers   Answer[] @relation("QuestionAnswers")
  order     Int? 

  @@unique([quizId, order])     // Ensures unique order per quiz

}

model Answer {
  id         String    @id @default(uuid())
  isCorrect  Boolean
  answer     String
  questionId String
  question   Question  @relation(name: "QuestionAnswers", fields: [questionId], references: [id])
  order      Int?    

  @@unique([questionId, order]) // Ensures unique order per question
}
