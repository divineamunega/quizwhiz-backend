generator client {
  provider = "prisma-client-js"
}

// This schema defines the data model for a quiz application using Prisma.
// It includes models for User, Quiz, Question, Answer, and RefreshToken.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum QuizVisibility {
  PUBLIC
  PRIVATE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum VerificationType {
  EMAIL
  PASSWORD_RESET
}

model User {
  id           String         @id @default(uuid())
  name         String
  password     String?
  googleId     String?
  email        String         @unique
  emailVerified Boolean      @default(false) // Indicates if the email is verified
  googleVerified Boolean     @default(false) // Indicates if the Google account is verified
  verifyCode  String?      // Code for email verification
  createdAt    DateTime      @default(now())
  avatar       String?
  quizzes      Quiz[]         @relation("CreatedQuizzes")
  RefreshToken RefreshToken[]
    verificationCode VerificationCode[]
}
model VerificationCode {
    id       String   @id @default(uuid())
    hashedCode String   @unique // Hashed verification code
    userId   String
    user    User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    expiresAt DateTime   // When the code expires
    type     VerificationType  // Type of verification (e.g., "email", "password_reset")
    isUsed   Boolean  @default(false) // Indicates if the code has been used

}

model RefreshToken {
  id        String   @id @default(uuid())
  value     String   @unique // Hashed refresh token string
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isEmailVerified Boolean @default(false) // Indicates if the email is verified
  isGoogleVerified Boolean @default(false) // Indicates if the Google account is verified
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String? // For auditing/login location
  userAgent String? // For client identification (browser, device)
  revoked   Boolean  @default(false) // Marks if token is revoked
}

model Quiz {
  id                String         @id @default(uuid())
  name              String
  description       String
  creatorId         String
  tags              String[]
  visibility        QuizVisibility
  creator           User           @relation(fields: [creatorId], references: [id], name: "CreatedQuizzes")
  questions         Question[]
  status            QuizStatus
  numberOfQuestions Int            @default(0)
  createdAt         DateTime       @default(now())
  joinCode          String         @default("")
}

model Question {
  id        String   @id @default(uuid())
  question  String
  image     String?
  createdAt DateTime @default(now())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  answers   Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  isCorrect  Boolean
  answer     String
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

enum QuizStatus {
  IDLE
  PROGRESS
  LOBBY
}
