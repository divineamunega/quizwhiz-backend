{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"baseUrl": "./",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"types": ["node"],
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipDefaultLibCheck": true
	},
	"include": ["src/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "dist"]
}
