{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"baseUrl": "./",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
