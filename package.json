{
	"name": "quizwhiz-backend",
	"version": "1.0.0",
	"description": "The backend repo for a quiz app",
	"main": "src/server.ts",
	"scripts": {
		"start": "dotenv -e .env.prod node dist/server.js",
		"dev": "dotenv -e .env.local nodemon src/server.ts",
		"build": "tsc",
		"migrate:dev": "dotenv -e .env.local --  npx prisma migrate dev",
		"migrate:prod": "dotenv -e .env.prod -- npx prisma migrate deploy",
		"prisma:generate": "npx prisma generate"
	},
	"keywords": [
		"Typescript",
		"Prisma",
		"Supabase",
		"Postgresql",
		"Javascript",
		"Fun"
	],
	"author": "Divine Amunega",
	"license": "ISC",
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.7",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/express-session": "^1.18.1",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/morgan": "^1.9.9",
		"@types/ms": "^2.1.0",
		"@types/passport-google-oauth20": "^2.0.16",
		"dotenv-cli": "^8.0.0",
		"env-cmd": "^10.1.0",
		"nodemon": "^3.1.4",
		"prisma": "^6.8.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@prisma/client": "^6.8.2",
		"bcryptjs": "^2.4.3",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"express": "^4.19.2",
		"express-session": "^1.18.1",
		"express-validator": "^7.1.0",
		"jsonwebtoken": "^9.0.2",
		"module-alias": "^2.2.3",
		"morgan": "^1.10.0",
		"ms": "^2.1.3",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"socket.io": "^4.7.5",
		"ts-node": "^10.9.2"
	},
	"_moduleAliases": {
		"@": "dist"
	}
}
