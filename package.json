{
	"name": "quizwhiz-backend",
	"version": "1.0.0",
	"description": "The backend repo for a quiz app",
	"main": "src/server.ts",
	"scripts": {
		"start": "dotenv -e .env.prod node dist/server.js",
		"dev": "dotenv -e .env.local nodemon src/server.ts",
		"build": "tsc",
		"migrate:dev": "dotenv -e .env.local --  npx prisma migrate dev",
		"migrate:prod": "dotenv -e .env.prod -- npx prisma migrate deploy",
		"prisma:generate": "npx prisma generate",
		"seed-test-data": "dotenv -e .env.local -- npx ts-node scripts/seed-test-data.ts",
		"clear-test-data": "dotenv -e .env.local -- npx ts-node scripts/clear-test-data.ts",
		"generate-quiz": "dotenv -e .env.local -- npx ts-node scripts/generate-sample-quiz.ts",
		"create-session": "dotenv -e .env.local -- npx ts-node scripts/create-live-session.ts",
		"check-db": "dotenv -e .env.local -- npx ts-node scripts/check-database.ts"
	},
	"keywords": [
		"Typescript",
		"Prisma",
		"Supabase",
		"Postgresql",
		"Javascript",
		"Fun"
	],
	"author": "Divine Amunega",
	"license": "ISC",
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.7",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/express-session": "^1.18.1",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/module-alias": "^2.0.4",
		"@types/morgan": "^1.9.9",
		"@types/ms": "^2.1.0",
		"@types/node": "^20.0.0",
		"@types/passport-google-oauth20": "^2.0.16",
		"dotenv-cli": "^8.0.0",
		"env-cmd": "^10.1.0",
		"nodemon": "^3.1.4",
		"prisma": "^6.10.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@prisma/client": "^6.11.1",
		"@types/redis": "^4.0.10",
		"bcryptjs": "^2.4.3",
		"bullmq": "^5.62.0",
		"connect-pg-simple": "^10.0.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"express": "^4.19.2",
		"express-session": "^1.18.2",
		"express-validator": "^7.1.0",
		"ioredis": "^5.8.2",
		"jsonwebtoken": "^9.0.2",
		"module-alias": "^2.2.3",
		"morgan": "^1.10.0",
		"ms": "^2.1.3",
		"nanoid": "^5.1.5",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"redis": "^5.8.3",
		"resend": "^4.5.1",
		"socket.io": "^4.7.5",
		"ts-node": "^10.9.2"
	},
	"_moduleAliases": {
		"@": "./dist"
	}
}
